NAME		= push_swap

CC			= cc
CFLAGS		= -Wall -Wextra -Werror
INCLUDES	= -Iinclude

SRC_DIR		= src
OBJ_DIR		= obj

SRCS		= push_swap.c \
			  stack.c \

SRC_FILES	= $(addprefix $(SRC_DIR)/, $(SRCS))
OBJ_FILES	= $(addprefix $(OBJ_DIR)/, $(SRCS:.c=.o))

# -----------------------------------------------------------------------------#
# Main rules
# -----------------------------------------------------------------------------#

all: $(NAME)

$(NAME): $(OBJ_FILES)
	$(CC) $(CFLAGS) $(OBJ_FILES) -o $(NAME)

# -----------------------------------------------------------------------------#
# Object compilation
# -----------------------------------------------------------------------------#

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c include/push_swap.h | $(OBJ_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

# -----------------------------------------------------------------------------#
# Cleaning
# -----------------------------------------------------------------------------#

clean:
	rm -rf $(OBJ_DIR)

fclean: clean
	rm -f $(NAME) libpushswap.so

re: fclean all

# -----------------------------------------------------------------------------#
# 🔬 Testing helpers (NOT used by Moulinette)
# -----------------------------------------------------------------------------#

lib: $(OBJ_FILES)
	$(CC) -shared -fPIC $(OBJ_FILES) -o libpushswap.so

test: lib
	pytest

# -----------------------------------------------------------------------------#
# Phony
# -----------------------------------------------------------------------------#

.PHONY: all clean fclean re lib test
